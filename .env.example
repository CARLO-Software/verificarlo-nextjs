DATABASE_URL="mysql://user:password@localhost:3306/mi_base?timezone=America%2FLima"

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=tu-secreto-generado-con-openssl
GOOGLE_CLIENT_ID=tu-client-id-de-google
GOOGLE_CLIENT_SECRET=tu-client-secret-de-google

# Genera un secreto con: openssl rand -base64 32
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Cloudinary (para subir PDFs e imágenes)
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret

#CONFIG para el envio de correos
RESEND_API_KEY=re_
EMAIL_FROM=<nombre>@carlo.com

# Culqi — Pasarela de pago
# https://dashboard.culqi.com/
NEXT_PUBLIC_CULQI_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
CULQI_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# Culqi Webhooks — Verificación de firma RSA
# Obtener en: Dashboard → Desarrollo → Webhooks → Ver detalles del webhook
# RSA ID: identificador de la clave pública (ej: key_live_xxxx)
CULQI_RSA_ID=
# RSA Public Key: clave pública completa en formato PEM
# (pegar todo el contenido incluyendo -----BEGIN PUBLIC KEY-----)
CULQI_RSA_PUBLIC_KEY=

# Google Maps / Places API
# https://console.cloud.google.com/apis/credentials
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=tu-api-key-de-google-maps