// ============================================
// VERIFICARLO - Schema de Base de Datos
// Sistema de Agendamiento Semiautomático
// ============================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================
// ENUMS
// ============================================

enum Role {
  CLIENT
  INSPECTOR
  ADMIN
}

enum InspectionType {
  legal
  basica
  completa
}

enum BookingStatus {
  PENDING_PAYMENT      // Slot reservado, esperando pago (30 min max)
  PENDING_VERIFICATION // Pago enviado (Yape/Transfer), esperando verificación admin
  PAID                 // Pagado (inspector se asigna por separado)
  COMPLETED            // Inspección realizada
  CANCELLED            // Cancelada por cliente/admin
  NO_SHOW              // Cliente no se presentó
  EXPIRED              // Pago no completado a tiempo
}

enum PaymentStatus {
  PENDING
  PENDING_VERIFICATION // Esperando verificación manual
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CULQI      // Tarjeta vía Culqi
  TRANSFER   // Transferencia bancaria
  YAPE_PLIN  // Yape o Plin
  WHATSAPP   // Coordinación por WhatsApp
}

enum InspectionResultStatus {
  PENDING   // Aún no evaluado
  OK        // Aprobado sin observaciones
  WARNING   // Aprobado con observaciones menores
  CRITICAL  // No aprobado - Requiere atención
}

// Veredicto final del mecánico (manual)
enum MechanicalVerdict {
  PENDING        // Aún no evaluado
  APROBADO       // Vehículo en óptimas condiciones - Color verde
  OBSERVADO      // Defectos menores encontrados - Color amarillo
  NO_APROBADO    // Siniestro o kilometraje adulterado - Color rojo
}

// ============================================
// AUTENTICACIÓN (NextAuth)
// ============================================

model User {
  id            String       @id @default(cuid())
  name          String
  email         String    @unique
  phone         String?   // Para WhatsApp
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(CLIENT)
  isInspectorAvailable Boolean   @default(true) // Para desactivar inspectores
  
  // Estado de la cuenta (soft delete / bloqueo)
  status        UserStatus @default(ACTIVE) //Activo - Suspendido (Esto se hace para evitar la eliminacion de una)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // ============================================
  // CAMPOS ESPECÍFICOS POR ROL
  // ============================================
  
  // Solo INSPECTOR: zona de atención y disponibilidad
  availability Json?     // {"lunes": ["09:00-13:00", "14:00-18:00"], ...}

  // Solo CLIENT: dirección para inspección a domicilio
  address      String?   // Dirección completa
  district     String?   // Distrito de Lima

  // Relaciones de autenticación
  accounts Account[]
  sessions Session[]

  // Relaciones de negocio
  vehicles         Vehicle[]
  clientBookings   Booking[]     @relation("ClientBookings")
  inspectorBookings Booking[]    @relation("InspectorBookings")
  blockedDates     BlockedDate[]

  // Relaciones de Informe Legal
  legalReportsLocked    LegalReport[] @relation("LegalReportLockedBy")
  legalReportsCompleted LegalReport[] @relation("LegalReportCompletedBy")

  // Relaciones de VehicleInspection
  vehicleInspectionsAsClient   VehicleInspection[] @relation("VehicleInspectionClient")
  vehicleInspectionsAsAdmin    VehicleInspection[] @relation("VehicleInspectionAdmin")
  vehicleInspectionsAsMechanic VehicleInspection[] @relation("VehicleInspectionMechanic")

  // Notificaciones in-app
  notifications         Notification[]

  // Créditos de inspección prepagados
  credits               UserCredit[]
}

enum UserStatus{
  ACTIVE
  SUSPENDED
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String? @db.Text
  id_token          String? @db.Text
  session_state     String? @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// CATÁLOGO DE PLANES DE INSPECCIÓN
// ============================================

model InspectionPlan {
  id          Int            @id @default(autoincrement())
  type        InspectionType
  title       String
  description String         @db.Text
  price       Int            // En soles (ej: 150 = S/150.00)

  items       InspectionPlanItem[]
  bookings    Booking[]
  userCredits UserCredit[]
}

model InspectionPlanItem {
  id               Int    @id @default(autoincrement())
  inspectionPlanId Int
  label            String

  inspectionPlan InspectionPlan @relation(fields: [inspectionPlanId], references: [id], onDelete: Cascade)

  @@index([inspectionPlanId])
}

// ============================================
// VEHÍCULOS
// ============================================

model Brand {
  id   Int    @id @default(autoincrement())
  name String @unique
  logo String

  models Model[]
}

model Model {
  id       Int    @id @default(autoincrement())
  brandId  Int
  name     String
  yearFrom Int
  yearTo   Int

  brand    Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  vehicles Vehicle[]

  @@unique([brandId, name])
  @@index([brandId])
}

// Vehículo del cliente (separado para reutilización)
model Vehicle {
  id      Int     @id @default(autoincrement())
  userId  String
  modelId Int
  year    Int
  plate   String? // Placa opcional
  mileage Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  model              Model               @relation(fields: [modelId], references: [id])
  bookings           Booking[]
  vehicleInspections VehicleInspection[]

  @@unique([plate]) // Única solo si tiene valor
  @@index([userId])
}

// ============================================
// RESERVAS (BOOKING)
// ============================================

model Booking {
  id Int @id @default(autoincrement())

  // Relaciones principales
  clientId         String
  inspectorId      String?  // Se asigna después del pago
  inspectionPlanId Int
  vehicleId        Int

  // Datos de la cita
  date      DateTime @db.Date // Solo fecha (YYYY-MM-DD)
  timeSlot  String   @db.VarChar(5) // "09:00", "10:00", etc.
  startTime DateTime // Fecha + hora completa
  endTime   DateTime // startTime + 60 min (1 hora)

  // Estado y control
  status    BookingStatus @default(PENDING_PAYMENT)
  expiresAt DateTime? // Para PENDING_PAYMENT (30 min)

  // Reprogramación
  isRescheduled   Boolean @default(false)
  rescheduledFrom Int? // ID del booking original

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  confirmedAt DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  // Notas
  clientNotes    String? @db.Text // Notas del cliente
  inspectorNotes String? @db.Text // Notas del inspector
  adminNotes     String? @db.Text // Notas del admin

  // Relaciones
  client         User              @relation("ClientBookings", fields: [clientId], references: [id], onDelete: Cascade)
  inspector      User?             @relation("InspectorBookings", fields: [inspectorId], references: [id], onDelete: SetNull)
  inspectionPlan InspectionPlan    @relation(fields: [inspectionPlanId], references: [id])
  vehicle        Vehicle           @relation(fields: [vehicleId], references: [id])
  payment        Payment?
  report         InspectionReport? // Informe de la inspección (solo si está COMPLETED)

  @@index([clientId])
  @@index([inspectorId])
  @@index([date, timeSlot])
  @@index([status])
  @@index([expiresAt])
  @@index([startTime])
}

// ============================================
// PAGOS
// ============================================

model Payment {
  id        Int @id @default(autoincrement())
  bookingId Int @unique

  // Método de pago utilizado
  method PaymentMethod @default(CULQI)

  // Datos Culqi (solo para method = CULQI)
  culqiChargeId String? @unique
  culqiEventId  String? @unique // Webhook event ID – idempotency key
  culqiToken    String?

  // Datos para pagos alternativos (Yape/Transfer)
  operationNumber String?   // Número de operación del cliente
  voucherUrl      String?   // URL del comprobante (opcional)

  // Verificación por admin
  verifiedBy String?   // ID del admin que verificó
  verifiedAt DateTime? // Fecha de verificación

  // Montos
  amount   Int    // En céntimos (ej: 15000 = S/150.00)
  currency String @default("PEN")

  // Estado
  status PaymentStatus @default(PENDING)

  // Datos de facturación
  receiptNumber String?
  receiptUrl    String?

  // Timestamps
  createdAt DateTime  @default(now())
  paidAt    DateTime?

  // Metadata de Culqi
  metadata Json?

  // Error info (si falla)
  errorCode    String?
  errorMessage String? @db.Text

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([culqiChargeId])
  @@index([culqiEventId])
  @@index([status])
  @@index([method])
}

// ============================================
// INFORME DE INSPECCIÓN
// ============================================

model InspectionReport {
  id        Int @id @default(autoincrement())
  bookingId Int @unique

  // ============================================
  // RESULTADOS POR CATEGORÍA
  // ============================================

  // Revisión Legal
  legalStatus       InspectionResultStatus @default(PENDING)
  legalScore        Int?                   // Puntaje 0-100
  legalObservations Json?                  // Array de observaciones detalladas
  // Estructura: [{ item: "Siniestros", status: "OK", note: "Sin registros" }, ...]

  // Revisión Mecánica
  mechanicalStatus       InspectionResultStatus @default(PENDING)
  mechanicalScore        Int?                   // Puntaje 0-100
  mechanicalObservations Json?                  // Array de observaciones
  // Estructura: [{ category: "Motor", item: "Aceite", status: "WARNING", note: "Nivel bajo" }, ...]

  // Revisión de Carrocería
  bodyStatus       InspectionResultStatus @default(PENDING)
  bodyScore        Int?                   // Puntaje 0-100
  bodyObservations Json?                  // Array de observaciones
  // Estructura: [{ area: "Puerta delantera izquierda", issue: "Rayón leve", severity: "minor" }, ...]

  // ============================================
  // CHECKLIST DE INSPECCIÓN (NUEVO SISTEMA)
  // ============================================

  // Resultados del checklist dinámico
  // Estructura: { "item-id": { "status": "OK" | "OBSERVACION" | "DEFECTO" | "NO_APLICA", "comment": "..." }, ... }
  checklistResults Json?

  // ============================================
  // DATOS ADICIONALES DEL VEHÍCULO
  // ============================================

  // Kilometraje registrado en inspección
  mileageAtInspection Int?

  // ============================================
  // RESUMEN Y RECOMENDACIONES
  // ============================================

  // Puntaje general (promedio ponderado)
  overallScore Int? // 0-100

  // Resultado final
  overallStatus InspectionResultStatus @default(PENDING)

  // ============================================
  // VEREDICTO DEL MECÁNICO (Manual)
  // ============================================

  // Veredicto final asignado por el mecánico
  mechanicalVerdict MechanicalVerdict @default(PENDING)

  // Indicadores de problemas graves (auto-rechazo)
  hasSiniestro            Boolean @default(false)  // Choque o accidente detectado
  hasKilometrajeAdulterado Boolean @default(false)  // Odómetro manipulado

  // Resumen ejecutivo (texto libre)
  executiveSummary String? @db.Text

  // Presupuesto estimado de reparaciones (en soles)
  estimatedRepairCost Decimal? @db.Decimal(10, 2)

  // ============================================
  // VERIFICACIÓN DE DOCUMENTOS
  // ============================================

  // Tarjeta de propiedad verificada
  ownershipCardVerified Boolean @default(false)

  // SOAT vigente
  soatValid Boolean @default(false)
  soatExpiryDate DateTime? @db.Date

  // Revisión técnica vigente
  technicalReviewValid Boolean @default(false)
  technicalReviewExpiryDate DateTime? @db.Date

  // ============================================
  // METADATA
  // ============================================

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime? // Cuando el inspector finalizó el informe

  // Firma digital del inspector (hash o URL)
  inspectorSignature String?

  // PDF generado
  pdfUrl    String?
  pdfHash   String? // Para verificar integridad

  // Relaciones
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  photos  InspectionPhoto[]
  legalReport LegalReport?  // Informe legal del admin (1:1)

  @@index([bookingId])
  @@index([overallStatus])
}

// ============================================
// FOTOS DE INSPECCIÓN
// ============================================

model InspectionPhoto {
  id         Int @id @default(autoincrement())
  reportId   Int

  // Vinculación al item del checklist (ej: "mec-sonidos-motor", "legal-tarjeta")
  checklistItemId String?

  // URL de la imagen (en Cloudinary, S3, etc.)
  url        String
  thumbnailUrl String?

  // Categoría de la foto (usar DAMAGE por defecto para hallazgos)
  category   PhotoCategory @default(DAMAGE)

  // Descripción/etiqueta opcional del inspector
  label      String?

  // Orden de visualización
  sortOrder  Int      @default(0)

  // Metadata
  createdAt  DateTime @default(now())

  // Relación
  report InspectionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([checklistItemId])
  @@index([category])
}

enum PhotoCategory {
  EXTERIOR_FRONT      // Frente del vehículo
  EXTERIOR_BACK       // Parte trasera
  EXTERIOR_LEFT       // Lado izquierdo
  EXTERIOR_RIGHT      // Lado derecho
  INTERIOR_DASHBOARD  // Tablero/odómetro
  INTERIOR_SEATS      // Asientos
  INTERIOR_TRUNK      // Maletero
  ENGINE              // Motor
  TIRES               // Llantas
  DOCUMENTS           // Documentos (tarjeta, SOAT, etc.)
  DAMAGE              // Daños encontrados
  OTHER               // Otros
}

// ============================================
// INFORME LEGAL (Para admins post-inspección)
// ============================================

enum LegalReportStatus {
  PENDING_REVIEW    // Inspector completó, esperando revisión admin
  IN_PROGRESS       // Admin está revisando (bloqueado)
  COMPLETED         // Revisión legal completada
}

enum LegalFieldStatus {
  OK        // Verde - Sin problemas
  WARNING   // Amarillo - Observaciones menores
  CRITICAL  // Rojo - Problemas graves
  PENDING   // Gris - Sin revisar
}

model LegalReport {
  id        Int @id @default(autoincrement())
  reportId  Int @unique  // Relación 1:1 con InspectionReport

  status    LegalReportStatus @default(PENDING_REVIEW)

  // ============================================
  // CAMPOS DEL INFORME LEGAL - Columna Izquierda
  // ============================================

  // Historial de propietarios
  ownerHistoryStatus     LegalFieldStatus @default(PENDING)
  ownerHistoryText       String?          @db.Text

  // Gravámenes SUNARP
  sunarpLiensStatus      LegalFieldStatus @default(PENDING)
  sunarpLiensText        String?          @db.Text

  // Orden de captura SAT
  satCaptureOrderStatus  LegalFieldStatus @default(PENDING)
  satCaptureOrderText    String?          @db.Text

  // SOAT
  soatStatus             LegalFieldStatus @default(PENDING)
  soatText               String?          @db.Text
  soatExpiryDate         DateTime?        @db.Date

  // Revisión técnica vehicular
  techReviewStatus       LegalFieldStatus @default(PENDING)
  techReviewText         String?          @db.Text
  techReviewExpiryDate   DateTime?        @db.Date

  // Situación de impuesto vehicular
  vehicleTaxStatus       LegalFieldStatus @default(PENDING)
  vehicleTaxText         String?          @db.Text

  // Transformado a gas
  gasConversionStatus    LegalFieldStatus @default(PENDING)
  gasConversionText      String?          @db.Text

  // ============================================
  // CAMPOS DEL INFORME LEGAL - Columna Derecha
  // ============================================

  // Papeletas SAT
  satTicketsStatus       LegalFieldStatus @default(PENDING)
  satTicketsText         String?          @db.Text

  // Papeletas CALLAO
  callaoTicketsStatus    LegalFieldStatus @default(PENDING)
  callaoTicketsText      String?          @db.Text

  // Papeletas SUTRAN
  sutranTicketsStatus    LegalFieldStatus @default(PENDING)
  sutranTicketsText      String?          @db.Text

  // Historial de Robos
  theftHistoryStatus     LegalFieldStatus @default(PENDING)
  theftHistoryText       String?          @db.Text

  // Registro de transportes
  transportRegistryStatus LegalFieldStatus @default(PENDING)
  transportRegistryText   String?          @db.Text

  // Datos de la última transferencia
  lastTransferStatus     LegalFieldStatus @default(PENDING)
  lastTransferText       String?          @db.Text

  // Siniestralidad
  accidentHistoryStatus  LegalFieldStatus @default(PENDING)
  accidentHistoryText    String?          @db.Text

  // ============================================
  // OBSERVACIONES GENERALES
  // ============================================

  otherObservations      String?          @db.Text

  // ============================================
  // BLOQUEO EXCLUSIVO
  // ============================================

  lockedBy               String?          // ID del admin que tiene bloqueado
  lockedAt               DateTime?        // Cuándo se bloqueó
  lockExpiresAt          DateTime?        // Expiración del bloqueo (15 min auto-release)

  // ============================================
  // METADATA
  // ============================================

  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  completedAt            DateTime?        // Cuándo admin finalizó
  completedBy            String?          // ID del admin que completó

  // Relaciones
  report         InspectionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  lockedByUser   User?            @relation("LegalReportLockedBy", fields: [lockedBy], references: [id], onDelete: SetNull)
  completedByUser User?           @relation("LegalReportCompletedBy", fields: [completedBy], references: [id], onDelete: SetNull)

  @@index([reportId])
  @@index([status])
  @@index([lockedBy])
}

// ============================================
// FECHAS BLOQUEADAS
// ============================================

model BlockedDate {
  id        Int      @id @default(autoincrement())
  date      DateTime @unique @db.Date
  reason    String?  // "Feriado - Fiestas Patrias", "Mantenimiento", etc.
  createdBy String
  createdAt DateTime @default(now())

  admin User @relation(fields: [createdBy], references: [id])

  @@index([date])
}

// ============================================
// SISTEMA DE INSPECCIÓN DE VEHÍCULOS (FLUJO DUAL)
// ============================================

// Estado de la inspección LEGAL (requiere placa)
enum LegalStatus {
  BLOQUEADO   // Sin placa → no se puede iniciar
  PENDIENTE   // Con placa → esperando que un admin tome el caso
  EN_PROCESO  // Admin tomó el caso, revisión en curso
  COMPLETADO  // Revisión legal finalizada
}

// Estado de la inspección MECÁNICA (independiente de la placa)
enum MechanicalStatus {
  PENDIENTE   // Mecánico asignado, esperando que inicie
  EN_PROCESO  // Mecánico inspeccionando
  COMPLETADO  // Inspección mecánica finalizada
}

model VehicleInspection {
  id    Int    @id @default(autoincrement())

  // Datos base
  vehicleId  Int
  clientId   String
  plate      String?   // Placa al momento de inspección; puede agregarse después

  // Asignaciones
  assignedAdminId    String?   // Admin que tomó el caso legal
  assignedMechanicId String?   // Mecánico asignado automáticamente al crear

  // Estados independientes (NO un estado global)
  legalStatus      LegalStatus      // BLOQUEADO si no hay placa al crear
  mechanicalStatus MechanicalStatus @default(PENDIENTE)

  // Grado de inspección (1-4 estrellas) - asignado manualmente por el inspector
  // 1 = Crítico, 2 = Observaciones importantes, 3 = Observaciones menores, 4 = Excelente
  grade Int?

  // Notas por proceso
  legalNotes    String?  @db.Text
  mechanicNotes String?  @db.Text
  adminNotes    String?  @db.Text

  // Datos del informe legal (JSON con todos los campos)
  // Estructura: { fieldName: { status: "OK"|"WARNING"|"CRITICAL"|"PENDING", text: "..." }, ... }
  legalReportData Json?

  // Capturas de pantalla de fuentes legales
  // Estructura: { sourceId: { imageUrl: "...", uploadedAt: "..." }, ... }
  legalScreenshots Json?

  // URL del PDF legal generado
  legalPdfUrl String?

  // Timestamps de cada transición de estado
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  plateAddedAt        DateTime? // Cuando el mecánico registró la placa (si no había al crear)
  legalUnlockedAt     DateTime? // Cuando legal pasó de BLOQUEADO → PENDIENTE
  legalStartedAt      DateTime? // Admin tomó el caso
  legalCompletedAt    DateTime?
  mechanicAssignedAt  DateTime? // Asignación automática al crear
  mechanicStartedAt   DateTime?
  mechanicCompletedAt DateTime?

  // Relaciones
  vehicle          Vehicle           @relation(fields: [vehicleId], references: [id])
  client           User              @relation("VehicleInspectionClient", fields: [clientId], references: [id])
  assignedAdmin    User?             @relation("VehicleInspectionAdmin", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  assignedMechanic User?             @relation("VehicleInspectionMechanic", fields: [assignedMechanicId], references: [id], onDelete: SetNull)
  notifications    Notification[]

  @@index([legalStatus])
  @@index([mechanicalStatus])
  @@index([clientId])
  @@index([assignedAdminId])
  @@index([assignedMechanicId])
  @@index([createdAt])
}

// ============================================
// NOTIFICACIONES IN-APP
// ============================================

enum NotificationType {
  NUEVA_INSPECCION       // Caso con placa creado → todos los admins
  LEGAL_DESBLOQUEADO     // Mecánico registró placa → todos los admins
  MECANICO_ASIGNADO      // Mecánico asignado al crear → mecánico
  INSPECCION_COMPLETADA  // Ambos procesos finalizados → cliente
}

model Notification {
  id           Int              @id @default(autoincrement())
  userId       String           // Destinatario
  type         NotificationType
  title        String
  message      String           @db.Text
  inspectionId Int?             // VehicleInspection relacionada
  read         Boolean          @default(false)
  createdAt    DateTime         @default(now())

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  inspection   VehicleInspection? @relation(fields: [inspectionId], references: [id], onDelete: SetNull)

  @@index([userId, read])
  @@index([userId])
  @@index([createdAt])
}

// ============================================
// CRÉDITOS DE INSPECCIÓN (Sistema prepago)
// ============================================

model UserCredit {
  id               String         @id @default(cuid())
  userId           String
  inspectionPlanId Int
  quantity         Int            @default(1)  // Créditos disponibles de este tipo

  // Tracking de compra
  purchasedAt      DateTime       @default(now())
  expiresAt        DateTime?      // Opcional: vencimiento del crédito

  // Referencia al pago original (para auditoría)
  paymentId        Int?

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  inspectionPlan   InspectionPlan @relation(fields: [inspectionPlanId], references: [id])

  @@unique([userId, inspectionPlanId]) // Un registro por tipo de plan por usuario
  @@index([userId])
  @@index([inspectionPlanId])
}

// Historial de uso de créditos (para auditoría)
model CreditUsage {
  id               String   @id @default(cuid())
  userId           String
  inspectionPlanId Int
  bookingId        Int      @unique  // La reserva que usó el crédito
  usedAt           DateTime @default(now())

  @@index([userId])
  @@index([bookingId])
}

// ============================================
// BLOG
// ============================================

model BlogCategory {
  id        String     @id @default(cuid())
  name      String     @unique
  slug      String     @unique
  color     String     @default("#FFD700")
  posts     BlogPost[]
  createdAt DateTime   @default(now())
}

model BlogPost {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  excerpt     String       @db.Text
  content     String       @db.Text
  coverImage  String
  categoryId  String
  category    BlogCategory @relation(fields: [categoryId], references: [id])
  author      String       @default("Verificarlo")
  published   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([categoryId])
  @@index([published])
  @@index([createdAt])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// ============================================
// REELS EDUCATIVOS (Landing Page)
// ============================================

enum EmbedType {
  INSTAGRAM
  TIKTOK
  YOUTUBE_SHORTS
}

enum ReelCategory {
  TIPS        // Tips para comprar
  FRAUDES     // Cómo detectar fraudes
  PROCESO     // Proceso de inspección
  TESTIMONIOS // Casos de éxito
}

model Reel {
  id           Int          @id @default(autoincrement())
  title        String       @db.VarChar(100)
  description  String?      @db.VarChar(300)

  // Embed (IG, TikTok, YouTube Shorts)
  embedUrl     String       @db.VarChar(500)
  embedType    EmbedType    @default(INSTAGRAM)

  // Visual
  thumbnailUrl String       @db.VarChar(500)

  // Organización
  category     ReelCategory @default(TIPS)
  sortOrder    Int          @default(0)

  // Métricas
  views        Int          @default(0)

  // Estado
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([isActive, sortOrder])
  @@index([category])
}
